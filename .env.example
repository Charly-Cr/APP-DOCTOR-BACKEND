# 🌐 URL de la base de datos local del desarrollador
# Formato: postgres://usuario:contraseña@localhost:puerto/nombre_db
# Este valor será usado si NODE_ENV está en 'development'
DATABASE_URL_DEV=postgres://postgres:root@127.0.0.1:5432/nombre de la base de datos

# PARA PRODUCCION:
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_HOST=
DB_PORT=

# 🧪 Entorno actual (development o production)
NODE_ENV=development

# 🔐 Secreto para firmar JWT
# Puedes generar uno con: require('crypto').randomBytes(64).toString('hex')
TOKEN_SECRET=

# ⏱️ Tiempo de expiración del token (ej: 1d, 12h, 30m)
TOKEN_EXPIRES_IN=1d

# 🚪 Puerto local donde correrá la app (por defecto 3000)
PORT=8080



# ☁️ Media
# =====================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# 💸 Pagos
# (solo producción)
# =====================
# Datos de Pago para Doctores
PAYMENT_YAPE_NUMBER=
PAYMENT_YAPE_NAME=
# URL DE CLOUDINARY
PAYMENT_YAPE_QR=


PAYMENT_BANK_NAME=
PAYMENT_BANK_ACCOUNT=
PAYMENT_BANK_CCI=
PAYMENT_BANK_OWNER=


# 📧 Email
# (solo producción con datos .env y si se usa en dev crear en local)
# =====================
EMAIL=
PASSWORD=
NEW_SUPERADMIN_PASSWORD=
